# Express Server
PORT=3000
NODE_ENV=development

# Web origin allowed by CORS
FRONTEND_URL=http://localhost:3000

# Convex service-to-service access
CONVEX_URL=https://replace-me.convex.cloud
CONVEX_BACKEND_SECRET=replace-with-a-shared-random-secret

# AI
GEMINI_API_KEY=replace_me
# GOOGLE_AI_API_KEY=replace_me
# Optional Vertex AI server route (requires all settings below):
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=global
# GEMINI_MODEL=gemini-3.8-flash
# GOOGLE_SERVICE_ACCOUNT_JSON=service-account-json-in-secret-storage

# Optional webpage fallback. Keep unset to use native HTML extraction only.
FIRECRAWL_API_KEY=
